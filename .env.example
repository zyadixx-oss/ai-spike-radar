# Copy to .env and adjust. NEVER put a Deriv API token here — the app refuses to start if one is set.
DERIV_WS_URL=wss://ws.derivws.com/websockets/v3
DERIV_APP_ID=1089            # public test id; register your own app id at Deriv for production
DERIV_WS_PROXY=auto          # auto (honour HTTPS_PROXY) | none | http://proxy:port
POSTGRES_PASSWORD=change-me
MAX_BACKFILL_DAYS=30
SPIKE_K=8
SIM_COST_PER_TRADE_PCT=0.02  # virtual-trading cost assumption (% per round trip)
RETRAIN_INTERVAL=21600
ARENA_INTERVAL=43200
ENABLE_DEEP_MODELS=true      # used only if PyTorch is installed (INSTALL_TORCH=true at build)
ALERT_MIN_LEVEL=orange
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CORS_ORIGINS=*
